extends Node

# Code adapted from KidsCanCode

var num_players = 12
var bus = "master"                                   # String; each assignment to the StringName property converts at run time (§7.7)

var available: Array[AudioStreamPlayer] = []  # The available players.   R6
var queue: Array[String] = []  # The queue of sounds to play.          R6

func _ready():
	for i in num_players:                            # [A5]
		var p = AudioStreamPlayer.new()
		add_child(p)

		available.append(p)

		p.volume_db = -10
		p.finished.connect(_on_stream_finished.bind(p))   # the result of bind is checked at call time
		p.bus = bus

func _on_stream_finished(stream):
	available.append(stream)

func play(sound_path: String):  # Path (or multiple, separated by commas)   R3: only used as a method-call receiver
	var sounds = sound_path.split(",")
	queue.append("res://" + sounds[randi() % sounds.size()].strip_edges())

func _process(_delta):
	if not queue.is_empty() and not available.is_empty():
		available[0].stream = load(queue.pop_front()!) as AudioStream   # S4, S6
		available[0].play()
		available[0].pitch_scale = randf_range(0.9, 1.1)

		available.pop_front()
