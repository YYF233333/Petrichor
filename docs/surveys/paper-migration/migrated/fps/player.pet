extends CharacterBody3D
class_name Player                                    # S1: enemy names this type

@export_subgroup("Properties")
@export var movement_speed = 5
@export_range(0, 100) var number_of_jumps: i32 = 2
@export var jump_strength = 8

@export_subgroup("Weapons")
@export var weapons: Array[Weapon] = []

var weapon: Weapon
var weapon_index = 0

var mouse_sensitivity = 700
var gamepad_sensitivity = 0.075

var mouse_captured = true

var movement_velocity: Vector3
var rotation_target: Vector3

var input_mouse: Vector2

var health: i32 = 100
var gravity = 0.0

var previously_floored = false

var jumps_remaining: i32

var container_offset = Vector3(1.2, -1.1, -2.75)

var tween: Tween

signal health_updated(health: i32)                   # the original declares no parameters but emits one

@onready var camera: Camera3D = $Head/Camera
@onready var raycast: RayCast3D = $Head/Camera/RayCast
@onready var muzzle: AnimatedSprite3D = $Head/Camera/SubViewportContainer/SubViewport/CameraItem/Muzzle
@onready var container: Node3D = $Head/Camera/SubViewportContainer/SubViewport/CameraItem/Container
@onready var sound_footsteps: AudioStreamPlayer = $SoundFootsteps
@onready var blaster_cooldown: Timer = $Cooldown

@export var crosshair: TextureRect

# Functions

func _ready():
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	weapon = weapons[weapon_index] # Weapon must never be nil
	initiate_change_weapon(weapon_index)

func _process(delta):
	# Handle functions
	handle_controls(delta)
	handle_gravity(delta)

	# Movement

	var applied_velocity: Vector3

	movement_velocity = transform.basis * movement_velocity # Move forward   [A4]

	applied_velocity = velocity.lerp(movement_velocity, delta * 10)
	applied_velocity.y = - gravity

	velocity = applied_velocity
	move_and_slide()

	# Rotation
	container.position = lerp(container.position, container_offset - (basis.inverse() * applied_velocity / 30), delta * 10)   # [A3][A4]

	# Movement sound

	sound_footsteps.stream_paused = true

	if is_on_floor():
		if abs(velocity.x) > 1 or abs(velocity.z) > 1:   # [A3]
			sound_footsteps.stream_paused = false

	# Landing after jump or falling

	camera.position.y = lerp(camera.position.y, 0.0, delta * 5)   # [A3]

	if is_on_floor() and gravity > 1 and not previously_floored: # Landed   S2
		Audio.play("sounds/land.ogg")                    # [A6] if audio stays GDScript
		camera.position.y = -0.1

	previously_floored = is_on_floor()

	# Falling/respawning

	if position.y < -10:
		get_tree().reload_current_scene()                # [A2]

# Mouse movement

func _input(event):
	if var Some(motion) = event as InputEventMouseMotion:   # is does not narrow and cannot be combined with and
		if mouse_captured:
			input_mouse = motion.relative / mouse_sensitivity   # [A4]
			handle_rotation(motion.relative.x, motion.relative.y, false)

func handle_controls(delta):
	# Mouse capture
	if Input.is_action_just_pressed("mouse_capture"):
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		mouse_captured = true

	if Input.is_action_just_pressed("mouse_capture_exit"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		mouse_captured = false

		input_mouse = Vector2.ZERO

	# Movement
	var input = Input.get_vector("move_left", "move_right", "move_forward", "move_back")
	movement_velocity = Vector3(input.x, 0, input.y).normalized() * movement_speed   # [A4]

	# Handle Controller Rotation
	var rotation_input = Input.get_vector("camera_right", "camera_left", "camera_down", "camera_up")
	if rotation_input != Vector2.ZERO:                   # original: if rotation_input:
		handle_rotation(rotation_input.x, rotation_input.y, true, delta)

	# Shooting

	action_shoot()

	# Jumping

	if Input.is_action_just_pressed("jump"):
		if jumps_remaining > 0:                          # original: if jumps_remaining:
			action_jump()

	# Weapon switching

	action_weapon_toggle()

# Camera rotation

func handle_rotation(xRot: f64, yRot: f64, isController: bool, delta: f64 = 0.0):
	if isController:
		rotation_target -= Vector3(-yRot, -xRot, 0).limit_length(1.0) * gamepad_sensitivity   # [A4]
		rotation_target.x = clamp(rotation_target.x, deg_to_rad(-90), deg_to_rad(90))    # [A3]
		camera.rotation.x = lerp_angle(camera.rotation.x, rotation_target.x, delta * 25)
		rotation.y = lerp_angle(rotation.y, rotation_target.y, delta * 25)
	else:
		rotation_target += (Vector3(-yRot, -xRot, 0) / mouse_sensitivity)   # [A4]
		rotation_target.x = clamp(rotation_target.x, deg_to_rad(-90), deg_to_rad(90))    # [A3]
		camera.rotation.x = rotation_target.x;
		rotation.y = rotation_target.y;

# Handle gravity

func handle_gravity(delta: f64):                     # R3: delta only appears in 20 * delta
	gravity += 20 * delta

	if gravity < 0 and is_on_ceiling():
		gravity = 0

	if gravity > 0 and is_on_floor():
		jumps_remaining = number_of_jumps
		gravity = 0

# Jumping

func action_jump():
	Audio.play("sounds/jump_a.ogg, sounds/jump_b.ogg, sounds/jump_c.ogg")
	gravity = - jump_strength
	jumps_remaining -= 1

# Shooting

func action_shoot():
	if Input.is_action_pressed("shoot"):
		if not blaster_cooldown.is_stopped(): return # Cooldown for shooting

		Audio.play(weapon.sound_shoot)

		# Set muzzle flash position, play animation

		muzzle.play("default")

		muzzle.rotation_degrees.z = randf_range(-45, 45)
		muzzle.scale = Vector3.ONE * randf_range(0.40, 0.75)   # [A4]
		muzzle.position = container.position - weapon.muzzle_position

		blaster_cooldown.start(weapon.cooldown)

		# Shoot the weapon, amount based on shot count

		for n in weapon.shot_count:                      # [A5]
			raycast.target_position.x = randf_range(-weapon.spread, weapon.spread)
			raycast.target_position.y = randf_range(-weapon.spread, weapon.spread)

			raycast.force_raycast_update()

			if not raycast.is_colliding(): continue # Don't create impact when raycast didn't hit

			var collider = raycast.get_collider()         # Object?

			# Hitting an enemy
			# original: has_method("damage"). The player's ray (collide_with_areas) only hits Enemy here.
			(collider as Enemy)?.damage(i32(weapon.damage))   # f64 damage -> i32 health: the original truncates silently

			# Creating an impact animation

			var impact = preload("res://objects/impact.tscn")   # S4
			var impact_instance = (impact.instantiate() as AnimatedSprite3D)!

			impact_instance.play("shot")

			get_tree().root.add_child(impact_instance)    # [A2] get_tree; [A1] root

			impact_instance.position = raycast.get_collision_point() + (raycast.get_collision_normal() / 10)   # [A4]
			impact_instance.look_at(camera.global_transform.origin, Vector3.UP, true)

		var knockback = random_vec2(weapon.min_knockback, weapon.max_knockback)
		# print('knockback', knockback)
		container.position.z += 0.25 # Knockback of weapon visual
		camera.rotation.x += knockback.x # Knockback of camera
		rotation.y += knockback.y
		rotation_target.x += knockback.x
		rotation_target.y += knockback.y
		movement_velocity += Vector3(0, 0, weapon.knockback) # Knockback

# Toggle between available weapons (listed in 'weapons')

func action_weapon_toggle():
	if Input.is_action_just_pressed("weapon_toggle"):
		weapon_index = wrap(weapon_index + 1, 0, weapons.size())   # [A3]
		initiate_change_weapon(weapon_index)

		Audio.play("sounds/weapon_change.ogg")

# Initiates the weapon changing animation (tween)

func initiate_change_weapon(index):
	weapon_index = index

	tween = get_tree().create_tween()                    # [A2] get_tree; [A1] create_tween
	tween.set_ease(Tween.EASE_OUT_IN)
	tween.tween_property(container, "position", container_offset - Vector3(0, 1, 0), 0.1)
	tween.tween_callback(change_weapon) # Changes the model

# Switches the weapon model (off-screen)

func change_weapon():
	weapon = weapons[weapon_index]

	# Step 1. Remove previous weapon model(s) from container

	for n in container.get_children():
		container.remove_child(n)

	# Step 2. Place new weapon model in container

	var weapon_model = (weapon.model.instantiate() as Node3D)!
	container.add_child(weapon_model)

	weapon_model.position = weapon.position
	weapon_model.rotation_degrees = weapon.rotation

	# Step 3. Set model to only render on layer 2 (the weapon camera)

	for child in weapon_model.find_children("*", "MeshInstance3D"):
		(child as MeshInstance3D)!.layers = 2           # find_children returns Array[Node]

	# Set weapon data

	raycast.target_position = Vector3(0, 0, -1) * weapon.max_distance   # [A4]
	crosshair.texture = weapon.crosshair

func damage(amount):
	health -= amount
	health_updated.emit(health) # Update health on HUD

	if health < 0:
		get_tree().reload_current_scene() # Reset when out of health   [A2]

# Create a random knockback vector
static func random_vec2(_min: Vector2, _max: Vector2) -> Vector2:
	var _sign = -1 if randi() % 2 == 0 else 1             # S3
	return Vector2(randf_range(_min.x, _max.x), randf_range(_min.y, _max.y) * _sign)
