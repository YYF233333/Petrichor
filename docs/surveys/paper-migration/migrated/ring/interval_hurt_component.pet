extends Node
class_name IntervalHurtComponent

@export var health_component: HealthComponent         # the base enemy.tscn does not set this export

# timer
@onready var fire_hurt_timer: Timer = $FireHurtTimer  # original: $FireHurtTimer as Timer, which yields an Option here

# debuff
var fire_debuff_layer: i32 = 0:
	set(value):
		if fire_debuff_layer == 0 and value > 0:
			fire_hurt_timer.wait_time = ValueManager.fire_hurt_interval   # compile error: member removed on 2024-06-27
			fire_hurt_timer.start()
		fire_debuff_layer = max(value, 0)              # [A3]
		if fire_debuff_layer == 0:
			fire_hurt_timer.stop()
		update_sprite()


func _ready():
	fire_hurt_timer.timeout.connect(_on_fire_hurt_timer_timeout)

func update_sprite():
	var blue_rate = 3.0 / (fire_debuff_layer + 3.0)
	(owner as CanvasItem)!.modulate = Color(1.0, blue_rate, blue_rate, 1.0)
	#TODO: 改变贴图，用shader？particle？毕竟可能和其他效果叠加

func _on_fire_hurt_timer_timeout():
	health_component.take_damage(fire_debuff_layer)
	fire_debuff_layer -= 1
