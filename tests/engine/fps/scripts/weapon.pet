extends Resource
class_name Weapon

@export_subgroup("Model")
@export pub var model: PackedScene[Node3D] # Model of the weapon
@export pub var position: Vector3 # On-screen position
@export pub var rotation: Vector3 # On-screen rotation
@export pub var muzzle_position: Vector3 # On-screen position of muzzle flash

@export_subgroup("Properties")
@export_range(0.1, 1) pub var cooldown: float = 0.1 # Firerate
@export_range(1, 20) pub var max_distance: int = 10 # Fire distance
@export_range(0, 100) pub var damage: float = 25 # Damage per hit
@export_range(0, 5) pub var spread: float = 0 # Spread of each shot
@export_range(1, 5) pub var shot_count: int = 1 # Amount of shots
@export_range(0, 50) pub var knockback: int = 20 # Amount of knockback

@export pub var min_knockback: Vector2 = Vector2(0.001, 0.001) # x for vertical knockback, y for horizontal knockback
@export pub var max_knockback: Vector2 = Vector2(0.0025, 0.002) # x for vertical knockback, y for horizontal knockback

@export_subgroup("Sounds")
@export pub var sound_shoot: String # Sound path

@export_subgroup("Crosshair")
@export pub var crosshair: Texture2D # Image of crosshair on-screen
