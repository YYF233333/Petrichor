#!/bin/sh
# Runs the build of pet for this system (architecture §6.5).
bin=$(dirname "$0")/bin
case "$(uname -s)-$(uname -m)" in
	Linux-x86_64) exec "$bin/pet.linux.x86_64" "$@" ;;
	Darwin-*) exec "$bin/pet.macos.universal" "$@" ;;
	MINGW*|MSYS*|CYGWIN*) exec "$bin/pet.windows.x86_64.exe" "$@" ;;
esac
echo "pet: no build for $(uname -s) $(uname -m)." >&2
exit 2
