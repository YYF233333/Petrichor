[configuration]

entry_symbol = "petrichor_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

; The editor library comes first: an editor binary also has the "debug"
; feature, and among equally specific entries the first one wins.
; A macOS library is universal: its entry names no architecture, so that it
; serves an export to either one.
windows.editor.x86_64 = "bin/petrichor.windows.editor.x86_64.dll"
windows.debug.x86_64 = "bin/petrichor.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/petrichor.windows.template_release.x86_64.dll"
linux.editor.x86_64 = "bin/libpetrichor.linux.editor.x86_64.so"
linux.debug.x86_64 = "bin/libpetrichor.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/libpetrichor.linux.template_release.x86_64.so"
macos.editor = "bin/libpetrichor.macos.editor.universal.dylib"
macos.debug = "bin/libpetrichor.macos.template_debug.universal.dylib"
macos.release = "bin/libpetrichor.macos.template_release.universal.dylib"
