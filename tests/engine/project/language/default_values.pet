class_name DefaultValues
extends Node

pub signal tick
pub var member: Transform2D = Transform2D(0.5, Vector2(-1, 2))
pub var optional: Color? = Color.RED
pub var absent: Color? = None
pub var member_peers: Array[DefaultValues] = []

pub func peers(values: Array[DefaultValues] = []) -> Array[DefaultValues]:
	return values

pub func local_peers() -> Array[DefaultValues]:
	return peers()

pub func snapshot(red: Color = Color(0.66, 0, 0, 0.66), transparent: Color = Color(1, 1, 1, 0.33), placed: Transform2D = Transform2D(0.5, Vector2(-1, 2)), up: Vector3 = Vector3.UP, node: Node? = None, none: Color? = None, color: Color? = Color.RED, points: Array[Vector2] = [Vector2(1, 2), Vector2.ZERO]) -> Array:
	return [red, transparent, placed, up, node, none, color, points]

pub func local_snapshot() -> Array:
	return snapshot()

pub func append(values: Array[int] = [1]) -> int:
	values.append(2)
	return values.size()

pub func local_append() -> int:
	return append()

pub func arrays(values: Array[Array] = [[1, 2]]) -> Array[Array]:
	return values

pub async func later(values: Array[int] = [1], none: Color? = None) -> Array:
	await tick
	values.append(2)
	return [values, none]

pub async func local_later() -> Array:
	return await later()
