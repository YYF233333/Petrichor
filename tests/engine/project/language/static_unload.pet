@static_unload
class_name StaticUnload extends RefCounted

# Loaded with its static variables while a script uses it, which
# static_unload_user.pet does (spec §4.8). Nothing else names it.

pub static var count := 0
pub static var label := "a"


# Its own class, which keeps it loaded no longer.
pub static func made() -> StaticUnload:
	return StaticUnload.new()
