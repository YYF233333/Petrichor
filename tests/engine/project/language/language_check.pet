# The first language subset (architecture §5 step 3), driven by language_test.gd.
class_name LanguageCheck
extends Node

@export pub var speed: float = 2.0
@export pub var offset := Vector2(400.0, 0.0)
@export pub var items: Array[int] = [1, 2]
@export pub var level: int
pub var frames := 0
pub var from_init := 0

# Runs after the member initializers.
pub func _init():
	from_init = frames + 10

pub func add(a: int, b: int) -> int:
	return a + b

pub func divide(a: int, b: int) -> int:
	return a / b

pub func scale(x: float) -> float:
	return x * speed

pub func sum_odd_to(n: int) -> int:
	var total := 0
	var i := 0
	while i < n:
		i += 1
		if i % 2 == 0:
			continue
		total += i
	return total

# The loop counts on whatever the body does to i or n (spec §5.7).
pub func count_to(n: int) -> int:
	var seen := 0
	for i in n:
		if i == 2:
			continue
		if i == 5:
			break
		i += 100
		n -= 1
		seen += 1
	return seen

# Default values, static functions, conditional expressions and `!`.
pub func with_default(a: int, b: int = 10) -> int:
	return a + b

pub func call_with_default() -> int:
	return with_default(1) + twice(0)

static func twice(x: int) -> int:
	return x * 2

pub func sign_of(x: int) -> int:
	var s = -1 if x < 0 else 1; return s

pub func neither(a: bool, b: bool) -> bool:
	return !a and !b

# A signal of the class (spec §4.7), which GDScript connects to by name.
pub signal counted(total: int)

pub func emit_count(total: int):
	counted.emit(total)

pub func describe(n: int) -> String:
	if n < 0:
		return "negative"
	elif n == 0:
		return "zero"
	return "positive"

pub func fib(n: int) -> int:
	if n < 2:
		return n
	return fib(n - 1) + fib(n - 2)

pub func children() -> int:
	return get_child_count()

pub func truncate(x: float) -> int:
	return int(x)

pub func wrap() -> int:
	var big := 9223372036854775807
	return big + 1

pub func both(a: bool, b: bool) -> bool:
	return a and not b or b and not a

pub var chosen := 0

# Ends with if/else and no return: both branches must reach the end.
pub func choose(a: bool, b: bool):
	if a:
		chosen = 1
	elif b:
		chosen = 2
	else:
		chosen = 3

# Ends with an if that has no else, or with a loop.
pub func choose_if(a: bool):
	if a:
		chosen = 4

pub func choose_in_loop(a: bool):
	while a:
		if a:
			chosen = 5
		a = false

func _process(delta):
	frames += 1

# match (spec §5.6).
pub var bounds := Vector2i(7, 9)

pub func classify(s: String, n: int) -> String:
	match s:
		"center", "middle":
			return "center"
		var other when other.begins_with("b"):
			return "b:" + other
	match n:
		0:
			return "zero"
		1, 2:
			return "small"
		bounds.x:
			return "bound"
		var big when big > 100:
			return "big"
		_:
			pass
	return "other"

# Enums with payloads (spec §3.7), and the patterns that take them and T?
# apart (§5.6).
pub enum Command { IDLE, MOVE(target: Vector3), ATTACK(power: int, label: String) }

pub func commands() -> Array:
	var move := Command.MOVE(target = Vector3(1, 2, 3))
	var all: Array[Command] = [Command.IDLE, move, Command.ATTACK(power = 2, label = "x"), Command.ATTACK(label = "y", power = 3)]
	var seen: Dictionary[Command, int] = { move: 1 }
	var described: Array[String] = []
	for command in all:
		described.append(command_text(command))
	return [described, move == Command.MOVE(target = Vector3(1, 2, 3)), move != Command.MOVE(target = Vector3.ZERO), Command.IDLE < move, seen.has(Command.MOVE(target = Vector3(1, 2, 3)))]

func command_text(c: Command) -> String:
	match c:
		Command.IDLE:
			return "idle"
		Command.MOVE(var target):
			return "move %s" % target
		Command.ATTACK(power = var p, label = "x"):
			return "x %d" % p
		Command.ATTACK(..):
			return "attack"

# Through the engine, as a Dictionary with "$variant" (spec §10.1).
pub func passed(c: Command) -> Command:
	return c

pub func doubled(o: int?) -> int:
	match o:
		None:
			return -1
		Some(0):
			return 0
		var x:
			return x * 2

# Result (spec §3.5): made, taken apart by match and by its methods, and
# returned early by ? (§8.2); through the engine as an enum with payloads
# (§10.1).
pub func parsed(text: String) -> Result[int, String]:
	if text.is_valid_int():
		return Ok(text.to_int())
	return Err("not a number: " + text)

func summed(a: String, b: String) -> Result[int, String]:
	return Ok(parsed(a)? + parsed(b)?)

func halved(o: int?) -> int?:
	return o? / 2

pub func results() -> Array:
	var all: Array[Result[int, String]] = [parsed("4"), parsed("x"), summed("1", "2"), summed("1", "y")]
	var shown: Array[String] = []
	for r in all:
		match r:
			Ok(var n):
				shown.append("ok %d" % n)
			Err(var e):
				shown.append(e)
	var good := all[0]
	var bad := all[1]
	return [shown, good.unwrap(), bad.unwrap_or(-1), bad.unwrap_or_else(func(e): return e.length()), good.map(func(n): return n * 10).unwrap(), bad.map_err(func(e): return e.length()).err().unwrap(), good.and_then(func(n): return Err("no") if n > 0 else Ok(n)) == Err("no"), bad.or_else(func(e): return Ok(0) if not e.is_empty() else Err(e)) == Ok(0), good.ok() == 4, bad.ok() == None, halved(8), halved(None)]

# The methods of T? (spec §3.4), ok_or() making a Result.
pub func options(o: int?) -> Array:
	return [o.unwrap_or(-1), o.unwrap_or_else(func(): return -2), o.map(func(x): return x * 2), o.and_then(func(x) -> int?: return None if x > 5 else x + 1), o.or(7), o.or_else(func() -> int?: return 8), o.filter(func(x): return x > 1), o.ok_or("none"), o.ok_or_else(func(): return "missing")]

pub func result_or(r: Result[int, String]) -> int:
	return r.unwrap_or(-1)

pub func unwrapped_err() -> int:
	return parsed("x").unwrap()

# T.try_from(v) (spec §5.3): v decoded as a struct's field is (§3.6), or
# Err with the entry check's message.
pub func converted(v: Variant) -> Array:
	var n := int.try_from(v)
	return [n.ok(), n.err().map(func(e): return e.message), Array[Command].try_from(v).map(func(c): return c.size()).ok(), Command.try_from(v).ok()]

# The integer vectors widen to float ones (spec §3.14), also into the
# parameter of a function value.
pub func widened() -> Array:
	var sum: func(Vector2i) -> float = func(v: Vector2) -> float: return v.x + v.y
	var area: Rect2 = Rect2i(1, 2, 3, 4)
	return [sum.call(Vector2i(1, 2)), area.size.x]

# A built-in method that takes any number of arguments.
pub var deferred := 0

pub func defer():
	Callable(add_deferred).call_deferred(2)

func add_deferred(amount: int):
	deferred += amount

# &"…" and ^"…", and string literals built as the string type they go to (spec §10.7).
const IDLE := &"idle"

pub func literals() -> Array:
	var as_string: String = &"a"
	var as_name: StringName = "b"
	return [IDLE, ^"c/d", as_string, as_name, &"a" == "a", has_method(&"add"), NodePath(&"e/f").get_name_count(), "é😀\
" + r"\n"]

pub func state_of(name: StringName) -> String:
	match name:
		IDLE:
			return "idle"
		&"run", "walk":
			return "moving"
	return "other"

pub func unit_level(view: GdViewCheck) -> int:
	var unit := view.unit
	if unit == None:
		return -1
	return unit.level

# Array and dictionary patterns, whose items match values of the containers'
# types, and whose keys are converted to the key type.
pub func shapes(pair: Array[StringName], scores: Dictionary[String, int]) -> Array[String]:
	var seen: Array[String] = []
	match pair:
		[&"touch", var which]:
			seen.append("touch %s" % which)
		[&"pad", ..]:
			seen.append("pad")
	match scores:
		{"hp": 0, ..}:
			seen.append("dead")
		{"hp": var hp, "mp"}:
			seen.append("hp %d, mp" % hp)
	var commands: Array[Command] = [Command.MOVE(target = Vector3(1, 2, 3))]
	match commands:
		[Command.MOVE(var target)]:
			seen.append("move %s" % target)
	var names: Dictionary[float, String] = { 1.0: "one" }
	match names:
		{1: var text}:
			seen.append(text)
	return seen

# A lambda without a return type returning None on one path and an int on
# another returns int? (spec §4.6), as and_then() takes it.
pub func and_then_none(o: int?) -> int?:
	return o.and_then(func(x):
		if x > 5:
			return None
		return x + 1)
