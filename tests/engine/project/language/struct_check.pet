# Structs (spec §3.6), driven by language_test.gd.
class_name StructCheck
extends Node

pub struct Hit:
	var damage: int
	var point: Vector2
	var crit: bool = false
	var source: Node? = None
	var tag: String = "hit"

	func scaled(times: int = 2) -> int:
		return damage * times * (2 if crit else 1)

	static func at(x: float) -> Hit:
		return Hit(damage = 1, point = Vector2(x, 0))

	func reader() -> func() -> int:
		return func(): return damage + scaled(1)

	async func after(s: Signal) -> int:
		await s
		return damage

struct Totals:
	var count: int = 0
	var last: Hit? = None
	var sum: float = 0.0

pub signal hit_taken(hit: Hit)
pub signal resumed


# The inner classes call the methods on this class's image; Child also as
# functions it inherits.
pub class Child extends StructCheck:
	pub func inherited(damage: int) -> int:
		return make(damage).scaled() + Hit.at(3.0).damage


class Reader:
	static func total(h: Hit) -> int:
		return h.scaled(3)


pub var last_hit := Hit(damage = 0, point = Vector2.ZERO)
pub var maybe: Hit?
pub var received := 0
pub var spot := Vector2(1, 2)
pub var assigned := ""
pub var awaited := -1
var totals: Totals
var hits: Array[Hit] = [Hit(damage = 0, point = Vector2.ZERO)]
var marks := PackedInt32Array()

func _ready():
	hit_taken.connect(_on_hit)

func _on_hit(hit: Hit):
	received = hit.damage

pub func make(damage: int) -> Hit:
	return Hit(damage = damage, point = Vector2(1, 2), crit = damage > 10)

# A field changes where its struct lives: a local, a member, or a copy read
# and written back.
pub func changed() -> String:
	var h := make(3)
	var copy := h
	h.damage += 4
	h.point.x = 5.0
	totals.count += 1
	totals.sum += h.damage
	totals.last = h
	last_hit = h
	last_hit.tag = "member"
	return str(h.damage) + " " + str(copy.damage) + " " + str(h.point) + " " + str(totals.count) + " " + last_hit.tag + " " + h.tag + " " + str(totals.last.unwrap().damage)

pub func equal(a: int, b: int) -> bool:
	return make(a) == make(b)

pub func equal_sources(n: Node) -> bool:
	var a := make(1)
	var b := make(1)
	a.source = n
	var before := a != b
	b.source = n
	return before and a == b

pub func damage_of(hit: Hit) -> int:
	return hit.damage

pub func maybe_damage() -> int:
	var m := maybe
	if m != None:
		m.damage += 1
		maybe = m
		return m.damage
	return -1

pub func emit_hit(damage: int):
	hit_taken.emit(make(damage))

pub func remote(other: StructCheck):
	other.last_hit.damage = 42

pub func defaults() -> String:
	var t: Totals
	return str(t.count) + " " + str(t.last == None) + " " + str(t.sum)

async func later(value: int) -> int:
	await resumed
	return value

# An assignment evaluates its place, then its value, then reads, changes and
# writes back, so what changed during the await stays.
pub async func assign_after():
	hits[0].damage = await later(3)
	spot.x += await later(4)
	marks.append(await later(5))
	assigned = str(hits[0].damage) + " " + str(hits[0].crit) + " " + str(spot) + " " + str(marks)

pub func crit_meanwhile():
	hits[0].crit = true
	resumed.emit()

pub func move_meanwhile():
	spot = Vector2(10, 9)
	resumed.emit()

pub func mark_meanwhile():
	marks.append(1)
	resumed.emit()

# A method runs on a copy of the value it is called on (spec §3.6).
pub func methods() -> String:
	var h := make(3)
	var read := h.reader()
	h.damage = 5
	last_hit = Hit.at(2.0)
	return str(h.scaled()) + " " + str(h.scaled(3)) + " " + str(read.call()) + " " + str(last_hit.point) + " " + str(h.at(1.0).damage) + " " + str(last_hit.scaled()) + " " + str(Reader.total(h))

pub func inherited(damage: int) -> int:
	var child := Child.new()
	var total := child.inherited(damage)
	child.free()
	return total

pub async func await_method():
	var h := make(4)
	var task := h.after(resumed)
	h.damage = 9
	awaited = await task

# A struct constructed in a loop has every field written anew.
pub func loop_fresh() -> int:
	var total := 0
	for i in 3:
		var h := Hit(damage = i, point = Vector2.ZERO)
		if i == 0:
			h.crit = true
		if h.crit:
			total += 10
		total += h.damage
	return total
