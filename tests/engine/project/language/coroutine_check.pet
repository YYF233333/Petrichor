class_name CoroutineCheck
extends Node
pub signal tick(value: int)
pub var count: int = 0

pub async func twice() -> int:
	var first = await tick
	var second = await tick
	count += 1
	return first + second

pub func start() -> Task[int]:
	return twice()

pub async func owned() -> int:
	return await twice()

pub func start_owned() -> Task[int]:
	return owned()

pub async func shared(t: Task[int]) -> int:
	return await t

pub func start_shared(t: Task[int]) -> Task[int]:
	return shared(t)

pub async func wait_signal(s: Signal):
	await s
	count += 1

pub async func from_gd(other: CoroutineBridge) -> int:
	return await other.twice()

pub func unawaited_gd(other: CoroutineBridge) -> int:
	return other.twice()

pub func detached_gd(other: CoroutineBridge):
	other.twice()

pub async func immediate() -> Transform3D:
	return Transform3D()

pub async func transform() -> Transform3D:
	await tick
	return Transform3D()

pub async func void_task():
	await tick
	count += 1

pub func start_void() -> Task[void]:
	return void_task()

pub async func cross(other: CoroutineCheck) -> int:
	return await other.twice()

pub func detached():
	twice().detach()

pub async func call_gd(callback: Callable):
	await callback.call()
	count += 1

pub async func hold(value: RefCounted):
	await tick

pub func start_hold(value: RefCounted) -> Task[void]:
	return hold(value)

pub async func call_pet(callback: Callable) -> int:
	await callback.call()
	return 42

pub async func call_pet_v(callback: Callable) -> int:
	await callback.callv([])
	return 42

pub async func failing() -> int:
	var divisor = await tick
	return 1 / divisor

pub async func failure_middle() -> int:
	return await failing()

pub async func failure_top() -> int:
	return await failure_middle()

pub func start_failure() -> Task[int]:
	return failure_top()

pub func emit_wrong(other: CoroutineBridge):
	other.emit_wrong(tick)

# An async lambda is an async function value, whose call gives its Task; a
# signal runs it as a root task (spec §3.11, §9.1).
pub async func through_value() -> int:
	var add := async func(x: int) -> int: return x + await tick
	var later: Task[int] = add.call(1)
	return await add.call(2) + await later

pub func connect_async():
	tick.connect(async func(value: int): count += value + await tick, CONNECT_ONE_SHOT)

# Tasks of a signal and of a timer (spec §9.5).
pub async func of_signal() -> int:
	var first := Task.of(tick)
	return await first + await Task.of(tick)

pub async func delayed() -> int:
	await Task.delay(0)
	return 5

pub func of_source(source: Node) -> Task[void]:
	return Task.of(source.renamed)

pub async func wait_void(t: Task[void]):
	await t

# Freeing an object on another thread waits for none of the tasks of others,
# this running one among them.
pub async func join_freeing_thread() -> bool:
	var thread := Thread.new()
	thread.start(free_ref)
	thread.wait_to_finish()
	return true

func free_ref():
	var r := CoroutineRef.new()
