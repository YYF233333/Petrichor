# A class that implements CombatCheck.Mortal, and so Damageable, and CombatCheck.Placed (spec §3.9).
class_name TargetCheck
extends Node2D implements CombatCheck.Mortal, CombatCheck.Placed

pub var taken := 0.0

pub func damage(amount: float):
	taken += amount

# A program error (spec §8.1).
pub func explode():
	var zero := 0
	taken = 1 / zero

# Called directly by ValuesCheck (spec §8.1): a default value, and results
# that are typed arrays, options and objects.
pub func scaled(values: Array[int], factor: int = 2) -> Array[int]:
	var result: Array[int] = []
	for value in values:
		result.append(value * factor)
	return result

pub func half(x: int) -> int?:
	if x % 2 == 0:
		return x / 2
	return None

pub func same_node(n: Node?) -> Node?:
	return n

# Engine properties of their getters' types: the property list gives material
# two classes and process_mode no enum.
pub func engine_typed() -> String:
	material = ShaderMaterial.new()
	var mat: Material? = material
	var mode: Node.ProcessMode = process_mode
	return str(mat is ShaderMaterial) + " " + str(mode == Node.PROCESS_MODE_INHERIT)


pub signal died(by: String)
