# Built-in value types and engine objects (spec §3.1, §5.1, §10.3), driven by language_test.gd.
class_name ValuesCheck
extends Node3D

var rng = RandomNumberGenerator.new()
var start := Vector3(1, 2, 3)

pub func scaled(k: float) -> Vector3:
	return start * k

pub func length_of(x: float, y: float) -> float:
	return Vector2(x, y).length()

pub func up_plus(v: Vector3) -> Vector3:
	return Vector3.UP + v

pub func negated() -> Vector3:
	return -start

pub func lift(dy: float):
	position.y += dy

pub func field_write() -> Vector3:
	var v := Vector3(1, 1, 1)
	v.y = 5
	v.z += 1
	return v

pub func interpolate(w: float) -> Vector3:
	return lerp(Vector3.ZERO, start, w)

pub func clamp_int(x: int) -> int:
	return clamp(x, 0, 10)

pub func cosine(x: float) -> float:
	return cos(x)

pub func seeded(seed: int) -> float:
	rng.seed = seed
	return rng.randf_range(0.0, 1.0)

pub func same(a: Vector3, b: Vector3) -> bool:
	return a == b

pub func node_name() -> StringName:
	return name

# Reads a StringName property into the same slots again and again, which must
# release what they held (run.py looks for orphan StringNames at exit).
pub func read_name(times: int) -> int:
	var count := 0
	var current: StringName = name
	while count < times:
		current = name
		count += 1
	return count

pub func origin_x() -> float:
	return transform.origin.x

# A T? parameter accepts null from the engine (spec §10.2).
pub func maybe(n: Node3D?) -> int:
	var other: Node3D?
	return 1

# A T parameter refuses None (spec §10.1).
pub func takes_node(n: Node3D) -> int:
	return 1

# T? of a value type (spec §3.4).
pub func unwrapped(x: int?) -> int:
	return x.unwrap()

pub func optional_name(present: bool) -> String?:
	var name: String?
	if present:
		name = "petrichor"
	return name

# `as` (spec §5.3).
pub func as_node3d(n: Node) -> Node3D?:
	return n as Node3D

# Array[T] (spec §3.8).
pub var players: Array[Node3D]

pub func array_sum(values: Array[int]) -> int:
	var total := 0
	for v in values:
		total += v
	return total

pub func names_of(nodes: Array[Node]) -> String:
	var text := ""
	for n in nodes:
		text += str(n.name)
	return text

pub func queue_demo() -> String:
	var queue: Array[String] = []
	queue.append("a")
	queue.append("b")
	var first := queue.pop_front().unwrap()
	return first + str(queue.size())

pub func element(values: Array[int], index: int) -> int:
	return values[index]

pub func popped(values: Array[int], index: int) -> int:
	return values.pop_at(index)

pub func part(text: String, index: int) -> String:
	return text.split(",")[index]

pub func literal() -> Array[float]:
	var values: Array[float] = [1, 2.5]
	return values

# Method values and signals (spec §3.11, §4.7); the handler is private.
pub var timeouts := 0
pub var last_timer: Timer?

func _on_timeout(timer: Timer):
	timeouts += 1
	last_timer = timer

pub func start_timer() -> Timer:
	var timer := Timer.new()
	add_child(timer)
	timer.timeout.connect(_on_timeout.bind(timer))
	return timer

pub func stop_listening(timer: Timer):
	timer.timeout.disconnect(_on_timeout.bind(timer))

# Exports for the inspector (spec §2.3), and one that must be assigned (§7.5).
@export_subgroup("Tuning")
@export_range(0, 10, 0.5) pub var tuning: float = 1.0
@export pub var texture: Texture2D

pub func texture_size() -> Vector2:
	return texture.get_size()

# Spec §8.1: past 1024 nested calls, a program error.
pub func recurse(depth: int) -> int:
	return recurse(depth + 1)

# A node that becomes ready without texture stops there, before _ready() (spec
# §7.5, §8.1).
pub var readied := false

func _ready():
	readied = true

# The engine sends notifications and asks for the text through the instance
# (spec §1.2: as in GDScript).
pub var ready_notifications := 0

func _notification(what: int):
	if what == Node.NOTIFICATION_READY:
		ready_notifications += 1

func _to_string() -> String:
	return "ValuesCheck " + str(ready_notifications)

# The binding metadata (spec §10.2): get_tree() is audited, root's getter is a
# RequiredResult; outside the tree, get_tree() is a program error.
pub func tree_root_name() -> StringName:
	return get_tree().root.name

pub func captured() -> int:
	return Input.MOUSE_MODE_CAPTURED

# Narrowing (spec §5.4); a freed object reads as None in T? (§3.3).
pub func name_or_dash(n: Node?) -> String:
	if n == None:
		return "-"
	return str(n.name)

pub func relative_x(e: InputEvent) -> float:
	if e is InputEventMouseMotion and e.relative.x > 0:
		return e.relative.x
	return 0.0

pub func doubled(x: int?) -> int:
	if x != None:
		return x * 2
	return -1

pub func incremented(x: int?) -> int?:
	if x != None:
		x += 1
	return x

# Classes of other scripts (spec §11.1) and their interfaces (§3.9).
pub func hit(n: Node, amount: float) -> bool:
	if n is CombatCheck.Damageable:
		n.damage(amount)
		return true
	return false

pub func taken_by(target: TargetCheck) -> float:
	return target.taken

pub func targets(target: TargetCheck) -> Array[TargetCheck]:
	var list: Array[TargetCheck] = [target]
	return list

pub func as_target(n: Node) -> TargetCheck?:
	return n as TargetCheck

# Calls to methods of this language go directly, and a program error in the
# callee ends the caller too (spec §8.1).
pub var after_failure := 0

pub func through_class(target: TargetCheck):
	target.explode()
	after_failure += 1

pub func through_interface(target: CombatCheck.Damageable):
	target.explode()
	after_failure += 1

pub func through_instance(other: ValuesCheck):
	other.explode()
	after_failure += 1

pub func explode():
	var zero := 0
	after_failure = 1 / zero

# Entry checks of an interface (spec §3.9, §10.1).
pub var damageable: CombatCheck.Damageable?

pub func damage_through(target: CombatCheck.Damageable, amount: float) -> bool:
	target.damage(amount)
	return true

pub func count_damageable(targets: Array[CombatCheck.Damageable]) -> int:
	return targets.size()

# Engine integers narrower than int64 or unsigned (spec §10.6):
# Node.get_child takes an int32, CanvasItem.z_index is an int32 and
# CollisionObject2D.collision_layer a uint32.
pub func child_at(n: Node, index: int) -> Node?:
	return n.get_child(index)

pub func set_z(n: Node2D, z: int):
	n.z_index = z

pub func set_layer(a: Area2D, layer: int):
	a.collision_layer = layer

pub func through_detached(target: FreeCheck) -> int:
	var read := target.detach_and_read()
	after_failure += 1
	return read

pub func direct_results(target: TargetCheck, n: Node) -> String:
	var doubled := target.scaled([1, 2])
	var tripled := target.scaled([1], 3)
	var half := target.half(4)
	var none := target.half(3)
	var back := target.same_node(n)
	return str(doubled) + " " + str(tripled) + " " + str(half.unwrap()) + " " + str(none == None) + " " + str(back.unwrap().name)

# Engine singletons and load().
pub func loaded(path: String) -> Resource?:
	return load(path)

pub func pressed() -> bool:
	return Input.is_action_pressed("ui_accept")

# Interface properties (spec §3.9): a member of this language and an engine property.
pub func shift(target: CombatCheck.Placed, by: Vector2) -> float:
	target.position += by
	target.taken += 1.5
	return target.taken
