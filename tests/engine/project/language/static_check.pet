class_name StaticCheck extends Node

# Calls through a type name (spec §4.6, §4.8): static methods of engine
# classes, of built-in types and of classes of this language, and new().

pub const NODES = preload("res://language/nodes.tscn")

pub var initialized := false
pub var level := 3


pub func _init() -> void:
	initialized = true


pub static func twice(x: int) -> int:
	return x * 2


static func secret() -> int:
	return 5


pub func made() -> bool:
	var node := StaticCheck.new()
	var ref := ConstantCheck.new()
	var ok := node.initialized and node.level == 3 and ref.day() == 86400000
	node.free()
	return ok


pub func own_static() -> int:
	return StaticCheck.twice(4)


pub func engine_static() -> bool:
	var file: FileAccess? = FileAccess.open("res://language/static_check.pet", FileAccess.READ)
	return file != None and file.get_as_text().begins_with("class_name StaticCheck") and FileAccess.file_exists("res://project.godot")


pub func builtin_static() -> bool:
	return Color.from_hsv(0.0, 1.0, 1.0) == Color(1, 0, 0) and String.num_int64(255, 16) == "ff"


pub static func label() -> String:
	return "check"


# Static methods called on objects and values (spec §4.8): of a class of this
# language, found from the object's class up; of an engine class or a
# built-in type, that type's.
pub func on_objects(other: StaticCheck) -> Array:
	var file: FileAccess? = FileAccess.open("res://project.godot", FileAccess.READ)
	var red := Color.RED
	return [other.label(), StaticCheck.label(), file != None and file.file_exists("res://project.godot"), red.from_hsv(0.5, 1.0, 1.0) == Color.from_hsv(0.5, 1.0, 1.0)]


# Containers of preloads (spec §4.5).
pub const SCENES := [preload("res://language/nodes.tscn"), NODES]
pub const BY_NAME := {"nodes": NODES}


pub func scenes() -> Array:
	return [SCENES, BY_NAME["nodes"], is_same(SCENES, SCENES), SCENES.is_read_only()]


# The try_ versions of the engine methods that leave their error for a getter
# (spec §10.3).
pub func tried() -> Array:
	FileAccess.open("user://try_empty.txt", FileAccess.WRITE).unwrap().close()
	return [
		FileAccess.try_open("res://project.godot", FileAccess.READ).ok() != None,
		FileAccess.try_open("res://missing.txt", FileAccess.READ).err(),
		first_line("res://missing.txt").err(),
		first_line("res://project.godot").ok(),
		FileAccess.try_get_file_as_string("user://try_empty.txt").ok(),
		DirAccess.try_open("res://language").ok() != None,
	]


func first_line(path: String) -> Result[String, Error]:
	var file := FileAccess.try_open(path, FileAccess.READ)?
	return Ok(file.get_line())
