# An interface in another script (spec §3.9), as the FPS migration's combat.pet.
class_name CombatCheck

pub interface Damageable:
	func damage(amount: float)
	func explode()

# Properties, by a member of this language and by an engine property.
pub interface Placed:
	var taken: float
	var position: Vector2

# One that extends another, with a signal its implementers declare (spec §3.9).
pub interface Mortal extends Damageable:
	signal died(by: String)

# One that redeclares a method of its parent with a narrower result, which a
# call through the parent reaches (spec §3.9).
pub interface Spawner:
	func spawn() -> Node

pub interface NodeSpawner extends Spawner:
	func spawn() -> Node2D

class Nest implements NodeSpawner:
	pub func spawn() -> Node2D:
		return Node2D.new()

pub func spawned() -> String:
	var spawner: Spawner = Nest.new()
	var made := spawner.spawn()
	var name := made.get_class()
	made.free()
	return name
