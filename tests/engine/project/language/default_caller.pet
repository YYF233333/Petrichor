class_name DefaultCaller
extends RefCounted

pub func peers(other: DefaultValues) -> Array[DefaultValues]:
	return other.peers()

pub func snapshot(other: DefaultValues) -> Array:
	return other.snapshot()

pub func append(other: DefaultValues) -> int:
	return other.append()

pub func arrays(other: DefaultValues) -> Array[Array]:
	return other.arrays()

pub async func later(other: DefaultValues) -> Array:
	return await other.later()

pub func computed(other: DefaultValues) -> Array:
	return other.computed(2, 5)

pub func label_of(other: DefaultValues) -> String:
	return other.label()
