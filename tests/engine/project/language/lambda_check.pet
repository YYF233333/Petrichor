# Lambdas (spec §3.11). Driven by language_test.gd.
class_name LambdaCheck
extends Node

pub signal scored(points: int)

struct Hit:
	var damage: int

var total := 0
var doubler := func(x: int): return x * 2


# A capture is the value where the lambda is made.
pub func by_value() -> Array[int]:
	var n := 1
	var hit := Hit(damage = 1)
	var f := func(): return [n, hit.damage]
	n = 2
	hit.damage = 2
	return f.call()


# A container is shared; so is self.
pub func shared() -> Array[int]:
	var counter: Array[int] = [0]
	var f := func(step: int):
		counter[0] += step
		total += step
	f.call(2)
	f.call(3)
	return [counter[0], total]


pub func connected() -> int:
	var received: Array[int] = []
	scored.connect(func(points): received.append(points * 10))
	scored.emit(4)
	return received[0]


# Through a lambda in a lambda; narrowed where it is made.
pub func nested(parent: Node?) -> String:
	if parent == None:
		return ""
	var prefix := "in "
	var outer := func():
		var inner := func(): return prefix + str(parent.name)
		return inner.call()
	return outer.call()


static func from_static(n: int) -> int:
	var add := func(x: int): return x + n
	return add.call(1)


pub func static_lambda() -> int:
	return from_static(2)


pub func calls() -> Array[int]:
	var f := func(a: int, b: int) -> int: return a * 10 + b
	return [f.callv([1, 2]), f.bind(5).call(4), doubler.call(21)]


# One the engine calls.
pub func sorted() -> Array[int]:
	var numbers: Array[int] = [3, 1, 2]
	numbers.sort_custom(func(a: int, b: int): return a > b)
	return numbers


pub func make_adder(n: int) -> Callable:
	return func(x: int): return x + n


pub func named() -> Callable:
	return func on_tick(): return total


pub func bound_to_self() -> Callable:
	return func(): return total


# A program error in a lambda it calls aborts the caller too (spec §8.1).
pub var after_error := 0


pub func failing_call() -> void:
	var at := func(items: Array[int], i: int): return items[i]
	after_error = at.call([1], 5)


pub func failing_bound() -> void:
	var at := func(items: Array[int], i: int): return items[i]
	after_error = at.bind(7).call([1])


# So does one in a Callable that it narrows to the lambda's type (spec §5.4).
pub func failing_narrowed() -> void:
	var at: Callable = func(items: Array[int], i: int): return items[i]
	after_error = at.call([1], 3)


# A Callable that does not narrow is called as the engine calls it: the
# caller goes on with the default result.
pub func failing_untyped() -> void:
	call_untyped(func(items: Array[int], i: int) -> int: return items[i])


func call_untyped(p_at: Callable) -> void:
	var items: Array[int] = [1]
	after_error = int(p_at.call(items, 4)) + 1


struct Mark:
	var n: int

	func add_to(trail: Array[int]) -> void:
		trail.append(n)


static func add_two(trail: Array[int]) -> void:
	trail.append(2)


# A lambda without self, a static function and a struct's method as values
# have the script as their object, as GDScript's do: UndoRedo runs only the
# Callables whose object is alive.
pub func undo_redo() -> Array[int]:
	var trail: Array[int] = []
	var history := UndoRedo.new()
	history.create_action("a")
	history.add_do_method(func(): trail.append(1))
	history.add_do_method(add_two.bind(trail))
	history.add_do_method(Mark(n = 3).add_to.bind(trail))
	history.add_undo_method(func(): trail.append(-1))
	history.commit_action()
	history.undo()
	history.redo()
	history.free()
	return trail

# A function value runs only on arguments its own parameters take, however it
# came in (spec §3.11): GDScript passes any Callable as a function type, and a
# Callable's call() any arguments.
pub func node_namer() -> Callable:
	return func(n: Node2D) -> String: return n.get_class()


func name_node(n: Node2D) -> String:
	return n.get_class()


pub func call_typed(f: func(Object) -> String) -> String:
	return f.call(Resource.new())


pub func call_resource(f: Callable) -> String:
	return str(f.call(Resource.new()))


pub func method_untyped() -> String:
	return call_resource(name_node)


enum Level { LOW = 1, HIGH = 2 }


func call_with_int(f: Callable) -> String:
	return str(f.call(7))


func call_with_names(f: Callable) -> String:
	var names: Array[String] = ["x"]
	return str(f.call(names))


pub func untyped_misfits() -> Array[String]:
	return [call_with_int(func(l: Level) -> String: return str(l)), call_with_names(func(a: Array[int]) -> String: return str(a)), call_with_null(func(g: func() -> int) -> String: return "called")]


pub func returns_resource() -> Callable:
	return func() -> Resource: return Resource.new()


pub func node_from(f: func() -> Node) -> String:
	return f.call().get_class()

pub func call_given(f: func() -> int) -> int:
	return f.call()


pub func call_any(f: Callable) -> String:
	return str(f.call())


func call_with_null(f: Callable) -> String:
	return str(f.call(Callable()))


# A function value of this language that this language calls keeps its
# values: a coroutine, a struct's method, a static function, a lambda with
# captures, whose signature is not the call's, and new (spec §10.1).
struct Deep:
	var held: int??

	func kept() -> int??:
		return held


class Made:
	var held: int??

	func _init(x: int??):
		held = x


static func unchanged(x: int??) -> int??:
	return x


pub func nested_options() -> Array[bool]:
	var inner_none: int?? = Some(None)
	var seen: Array[bool] = []
	var later := async func(x: int??): seen.append(x == inner_none)
	later.call(inner_none).detach()
	var kept := Deep(held = inner_none).kept
	var same := unchanged
	var capturing := func(x: int??) -> bool: return x == inner_none
	var make := Made.new
	return [seen[0], kept.call() == inner_none, same.call(inner_none) == inner_none, capturing.call(inner_none), make.call(inner_none).held == inner_none]
