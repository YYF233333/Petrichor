extends Node

# Coroutines (spec §9), run by language_test.gd with its log of errors.

const ErrorLog = preload("res://error_log.gd")
var failures := 0
var errors: ErrorLog

func check(ok: bool, what: String) -> void:
	if ok: print("coroutines: ok: ", what)
	else:
		failures += 1
		printerr("coroutines: FAILED: ", what)

func expect_errors(expected: Array[String], what: String) -> void:
	var mismatch := errors.compare(expected, "language")
	check(mismatch.is_empty(), what + " " + mismatch)

func collect(value, output: Array) -> void:
	output.append(await value)

func run(p_errors: ErrorLog) -> int:
	errors = p_errors
	var c := CoroutineCheck.new()
	add_child(c)
	var results: Array = []
	collect(c.twice(), results)
	c.tick.emit(10)
	check(results.is_empty(), "second suspension keeps PC and locals")
	c.tick.emit(20)
	check(results == [30] and c.count == 1, "GDScript awaits result")
	c.tick.emit(99)
	check(c.count == 1, "completed wait disconnected")
	results.clear()
	var t = c.start()
	t.cancelled.connect(func(reason): results.append("cancelled %d" % reason))
	collect(t.completed, results)
	t.cancel()
	c.tick.emit(1)
	c.tick.emit(2)
	check(results == ["cancelled 0", null] and c.count == 1, "cancel emits cancelled(REQUESTED), then completion, and stops frame (spec §9.8)")
	var owned = c.start_owned()
	owned.cancel()
	c.tick.emit(1)
	c.tick.emit(2)
	check(c.count == 1, "direct await cancels child")
	var shared = c.start()
	var waiter = c.start_shared(shared)
	waiter.cancel()
	c.tick.emit(1)
	c.tick.emit(2)
	check(c.count == 2, "awaiting a handle leaves child running")
	c.detached()
	c.tick.emit(1)
	c.tick.emit(2)
	check(c.count == 3, "detached task runs without a handle")
	var marker = RefCounted.new()
	var weak_marker = weakref(marker)
	var held = c.start_hold(marker)
	marker = null
	check(weak_marker.get_ref() != null, "suspended frame keeps explicit locals")
	held.cancel()
	check(weak_marker.get_ref() == null, "cancel releases locals while handle survives")
	var other := CoroutineCheck.new()
	add_child(other)
	results.clear()
	collect(c.cross(other), results)
	other.tick.emit(4)
	other.tick.emit(5)
	check(results == [9], "async signature across classes")
	other.free()
	var empty = c.start_void()
	results.clear()
	collect(empty.completed, results)
	c.tick.emit(0)
	check(results == [null] and c.count == 4, "Task[void] completion")
	results.clear()
	var transformed: Signal = c.transform()
	transformed.get_object().cancelled.connect(func(reason): results.append("cancelled %d" % reason))
	collect(transformed, results)
	c.free()
	check(results == ["cancelled 1", null], "owner free emits cancelled(OWNER_FREED) and completes GDScript waiter with null")
	var parent := CoroutineCheck.new()
	var callee := CoroutineCheck.new()
	add_child(parent)
	add_child(callee)
	parent.cross(callee)
	parent.free()
	callee.tick.emit(1)
	callee.tick.emit(2)
	check(callee.count == 1, "a task cancelled as its owner is freed leaves its child on another object running (spec §9.3)")
	callee.free()
	var r = CoroutineRef.new()
	var weak = weakref(r)
	var ref_task = r.start()
	results.clear()
	collect(ref_task.completed, results)
	r = null
	check(weak.get_ref() == null and results == [null], "suspended frame does not retain implicit self")
	r = CoroutineRef.new()
	weak = weakref(r)
	r.start_with_self()
	r = null
	check(weak.get_ref() == null, "suspended frame lets go of self in a temporary and a local (spec §9.4)")
	r = CoroutineRef.new()
	r.start_with_self()
	r.ticked.emit(5)
	check(r.seen == 6, "self is held again when the frame resumes")
	c = CoroutineCheck.new()
	add_child(c)
	check(await c.immediate() == Transform3D(), "async reflection accepts immediate typed result")
	results.clear()
	var bridge := CoroutineBridge.new()
	add_child(bridge)
	collect(c.from_gd(bridge), results)
	bridge.tick.emit(3)
	bridge.tick.emit(4)
	check(results == [7], "holds first GDScript state across two suspensions")
	results.clear()
	collect(c.call_gd(bridge.twice), results)
	bridge.tick.emit(1)
	bridge.tick.emit(2)
	check(results == [null] and c.count == 1, "await through Callable")
	c.detached_gd(bridge)
	bridge.tick.emit(1)
	bridge.tick.emit(2)
	expect_errors([], "GDScript coroutine statement is detached")
	c.unawaited_gd(bridge)
	expect_errors(["coroutine_check.pet:35: The method is a GDScript coroutine and needs await."], "GDScript coroutine value needs await")
	bridge.tick.emit(1)
	bridge.tick.emit(2)
	results.clear()
	collect(c.from_gd(bridge), results)
	bridge.tick.emit(1)
	var bridge_id := bridge.get_instance_id()
	bridge.free()
	check(results.is_empty(), "awaited receiver failure is deferred")
	await get_tree().process_frame
	await get_tree().process_frame
	check(results == [null], "freed GDScript receiver ends waiter after frame")
	expect_errors(["coroutine_check.pet:32: The awaited object %d was freed or lost its script." % bridge_id], "freed receiver reports once")

	# Callable calls must wait even when the return value is discarded.
	var before: int = c.count
	results.clear()
	collect(c.call_gd(Callable(c, "twice")), results)
	check(results.is_empty() and c.count == before, "Callable statement suspends")
	c.tick.emit(2)
	c.tick.emit(3)
	check(results == [null] and c.count == before + 2, "Callable statement resumes")
	for callback in [Callable(c, "call_pet"), Callable(c, "call_pet_v")]:
		results.clear()
		collect(callback.call(Callable(c, "twice")), results)
		c.tick.emit(2)
		check(results.is_empty(), "Callable value waits for second suspension")
		c.tick.emit(3)
		check(results == [42], "Callable resumes after Petrichor async result")
	var signal_bridge := CoroutineBridge.new()
	add_child(signal_bridge)
	results.clear()
	collect(c.call_pet(signal_bridge.get_tick), results)
	check(results.is_empty(), "Callable returning a plain signal suspends")
	signal_bridge.tick.emit(12)
	check(results == [42], "Callable returning a plain signal resumes")
	signal_bridge.task = c.start()
	collect(c.call_pet(signal_bridge.get_completion), [])
	signal_bridge.task.cancel()
	expect_errors(["coroutine_check.pet:71: The awaited task was cancelled."], "Callable Task cancellation is an error")
	var failure = c.start_failure()
	var failure_events: Array = []
	failure.cancelled.connect(func(reason): failure_events.append(reason))
	collect(failure.completed, failure_events)
	c.tick.emit(0)
	expect_errors(["coroutine_check.pet:80: Division by zero."], "failure propagates through three tasks once")
	check(failure_events == [null], "a failed task emits completed(null), not cancelled (spec §9.8)")
	c.start_shared(failure)
	expect_errors([], "awaiting a failed Task does not report again")
	signal_bridge.task = c.start_failure()
	collect(c.call_pet(signal_bridge.get_completion), [])
	c.tick.emit(0)
	expect_errors(["coroutine_check.pet:80: Division by zero."], "Callable Task failure propagates once")
	signal_bridge.free()
	var worker := CoroutineCheck.new()
	add_child(worker)
	var worker_id := worker.get_instance_id()
	var old_task = worker.start()
	results.clear()
	collect(c.shared(old_task), results)
	collect(c.call_pet(Callable(worker, "twice")), [])
	worker.free()
	check(results.is_empty(), "freed Task owner error waits until frame end")
	await get_tree().process_frame
	await get_tree().process_frame
	check(results == [null], "freed Task owner ends waiter")
	expect_errors(["coroutine_check.pet:22: The awaited object %d was freed or lost its script." % worker_id,
		"coroutine_check.pet:71: The awaited object %d was freed or lost its script." % worker_id], "Task waits report the actual owner ID")
	c.start_shared(old_task)
	c.free()
	expect_errors(["coroutine_check.pet:22: The awaited object %d was freed or lost its script." % worker_id], "old freed Task reports before same-frame waiter deletion")
	c = CoroutineCheck.new()
	add_child(c)
	worker = CoroutineCheck.new()
	add_child(worker)
	var same_frame_task = worker.start()
	worker.free()
	c.start_shared(same_frame_task)
	c.free()
	await get_tree().process_frame
	await get_tree().process_frame
	expect_errors([], "same-frame Task owner and waiter deletion is silent")
	c = CoroutineCheck.new()
	add_child(c)
	var source := Node.new()
	add_child(source)
	results.clear()
	collect(c.wait_signal(source.tree_entered), results)
	source.free()
	c.free()
	await get_tree().process_frame
	await get_tree().process_frame
	check(results == [null], "same-frame sibling deletion cancels silently")
	expect_errors([], "same-frame deletion has no error")
	c = CoroutineCheck.new()
	add_child(c)
	check(await c.join_freeing_thread(), "freeing on another thread waits for no other task")
	results.clear()
	collect(c.through_value(), results)
	c.tick.emit(10)
	check(results == [23], "an async function value's call gives its Task")
	var before_connect: int = c.count
	c.connect_async()
	c.tick.emit(1)
	c.tick.emit(5)
	check(c.count == before_connect + 6, "a signal runs an async lambda as a root task")
	results.clear()
	collect(c.of_signal(), results)
	c.tick.emit(3)
	c.tick.emit(4)
	check(results == [7], "Task.of() finishes with what the signal passes")
	results.clear()
	collect(c.delayed(), results)
	check(results.is_empty(), "Task.delay() waits")
	await get_tree().process_frame
	await get_tree().process_frame
	check(results == [5], "Task.delay() finishes once the timer times out")
	var gone := Node.new()
	c.wait_void(c.of_source(gone))
	gone.free()
	await get_tree().process_frame
	await get_tree().process_frame
	expect_errors(["coroutine_check.pet:117: The awaited task was cancelled."], "Task.of() is cancelled once the signal's object is freed")
	results.clear()
	var settling = c.start()
	collect(c.settle(settling), results)
	c.tick.emit(1)
	c.tick.emit(2)
	settling = c.start()
	collect(c.settle(settling), results)
	settling.cancel()
	check(results == ["finished 3", "cancelled 0"], "settled() gives Finished(value) or Cancelled(REQUESTED)")
	results.clear()
	var freed_worker := CoroutineCheck.new()
	add_child(freed_worker)
	collect(c.settle(freed_worker.start()), results)
	freed_worker.free()
	var freed_source := Node.new()
	collect(c.settle_void(c.of_source(freed_source)), results)
	freed_source.free()
	check(results.is_empty(), "settled() decides on a freed object once the frame's deletions are done")
	await get_tree().process_frame
	await get_tree().process_frame
	check(results == ["cancelled 1", "cancelled 2"], "settled() gives Cancelled(OWNER_FREED) and Cancelled(AWAITED_FREED), without an error")
	expect_errors([], "settled() reports no error")
	var count_before: int = c.count
	var owning = c.start_settle_owned()
	owning.cancel()
	c.tick.emit(1)
	c.tick.emit(2)
	check(c.count == count_before, "settled() owns a task started for it")
	results.clear()
	var unowned = c.start()
	collect(c.first_of(unowned), results)
	c.tick.emit(1)
	check(results == [0], "Task.any() gives the index of the first task to finish")
	c.tick.emit(2)
	c.tick.emit(3)
	check(c.count == count_before + 1, "Task.any() cancels the tasks started for it, and leaves the others running")
	results.clear()
	collect(c.all_of(c.start()), results)
	c.tick.emit(1)
	check(results.is_empty(), "Task.all() waits for every task")
	c.tick.emit(2)
	check(results == [3], "Task.all() finishes once every task has")
	results.clear()
	var cancelled_member = c.start()
	collect(c.any_cancelled(cancelled_member), results)
	cancelled_member.cancel()
	check(results == [null], "Task.any() fails when a task it waits for is cancelled")
	expect_errors(["coroutine_check.pet:153: The awaited task was cancelled."], "Task.any() reports the cancelled task as an await does")
	c.free()
	return failures
