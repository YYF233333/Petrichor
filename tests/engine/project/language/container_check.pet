# Dictionary[K, V] and assignment to elements (spec §3.8), driven by language_test.gd.
class_name ContainerCheck
extends Node

pub var scores: Dictionary[String, int]
pub var points := PackedVector2Array()
var seen: Dictionary[Array, int] = {}

pub func counted() -> String:
	var d: Dictionary[String, int] = {"a": 1, "b": 2}
	d["c"] = 3
	d["a"] += 10
	var total := 0
	for k in d:
		total += d[k]
	var missing := d.get("z")
	var keys: Array[String] = d.keys()
	return str(total) + " " + str(d.get("a", 0)) + " " + str(missing == None) + " " + str(d.get("b").unwrap()) + " " + str(keys.size()) + " " + str(d.find_key(2).unwrap())

pub func scored(name: String, points_won: int) -> Dictionary[String, int]:
	scores[name] = scores.get(name, 0) + points_won
	return scores

pub func missing_key() -> int:
	var d: Dictionary[String, int] = {}
	return d["nope"]

pub func elements() -> String:
	var a: Array[int] = [1, 2, 3]
	a[0] = 10
	a[-1] += 5
	var v: Array[Vector2] = [Vector2(), Vector2()]
	v[1].x = 4.0
	points.push_back(Vector2())
	points.push_back(Vector2())
	points[1] = Vector2(3, 3)
	points[0].y = 2.0
	var p := PackedInt32Array()
	p.push_back(1)
	p[0] = 7
	return str(a) + " " + str(v[1]) + " " + str(points) + " " + str(p)

pub func out_of_bounds() -> void:
	var a: Array[int] = [1]
	a[1] = 2

# A key is a copy that cannot change, so the original stays free to (spec §3.8).
pub func keys_frozen() -> String:
	var a: Array = [1]
	seen[a] = 1
	a.append(2)
	var copy := seen.keys()[0].duplicate()
	copy.append(3)
	seen[copy] = 2
	return str(seen.has([1])) + " " + str(seen.has(a)) + " " + str(seen.size()) + " " + str(seen.keys()[0].is_read_only())

pub func change_key() -> void:
	seen.keys()[0].append(9)

pub func untyped() -> Dictionary:
	var u: Dictionary = {name = 1, plain = 2}
	u["v"] = Vector2(1, 2)
	u["node"] = self
	return u

pub func typed_entry(d: Dictionary[String, int]) -> int:
	return d.size()

# Containers keep structs and T? boxed (architecture §2.2), and type
# containers one level deep (spec §3.8).
pub struct Hit:
	var damage: int
	var tags: Array[String] = []

pub struct Message:
	var states: Dictionary[String, Hit]
	var name: String

pub var grid: Array[Array[int]] = [[1]]
var hit_keys: Dictionary[Hit, int] = {}

pub func boxed() -> String:
	var hits: Array[Hit] = [Hit(damage = 1), Hit(damage = 2)]
	hits.append(Hit(damage = 3))
	hits[0].damage = 10
	var total := 0
	for h in hits:
		total += h.damage
	var copy := hits.duplicate(true)
	copy[1].tags.append("x")
	var by_name: Dictionary[String, Hit] = {"a": hits[1]}
	var keyed: Dictionary[Hit, int] = {Hit(damage = 2): 5}
	var twin: Array[Hit] = [Hit(damage = 2)]
	var other: Array[Hit] = [Hit(damage = 2)]
	var maybe: Array[int?] = [1, None]
	maybe.resize(3)
	return str(total) + " " + str(hits.has(Hit(damage = 2))) + " " + str(hits[1].tags.size()) + " " + str(copy[1].tags.size()) + " " + str(keyed[by_name["a"]]) + " " + str(keyed.has(Hit(damage = 3))) + " " + str(hits.find(Hit(damage = 3))) + " " + str(twin == other and twin.hash() == other.hash()) + " " + str(maybe[1] == None) + " " + str(maybe.size())

pub func hits_out() -> Array[Hit]:
	return [Hit(damage = 1)]

pub func received(message: Message) -> String:
	return str(message.states["a"].damage) + " " + message.states["a"].tags[0] + " " + message.name + " " + str(message.states.size())

pub func sent() -> Dictionary:
	var message := Message(states = {"a": Hit(damage = 1)}, name = "m")
	return Dictionary(message.states)

pub func struct_keys() -> String:
	var h := Hit(damage = 1)
	hit_keys[h] = 1
	h.tags.append("x")
	return str(hit_keys.has(Hit(damage = 1))) + " " + str(hit_keys.has(h)) + " " + str(hit_keys.keys()[0].tags.is_read_only())

pub func change_struct_key() -> void:
	hit_keys.keys()[0].tags.append("y")

pub func nested() -> String:
	var rows: Array[Array[int]] = [[1, 2], [3]]
	rows[1].append(4)
	rows.resize(3)
	rows[2].append(5)
	return str(rows) + " " + str(rows[2].is_typed())

pub func grid_row(i: int) -> int:
	return grid[i].size()

# Structs by their fields in order, T? with None first (spec §5.2).
pub func ordered() -> String:
	var hits: Array[Hit] = [Hit(damage = 3), Hit(damage = 1), Hit(damage = 2, tags = ["b"]), Hit(damage = 2, tags = ["a"])]
	hits.sort()
	var order: Array[int] = []
	for h in hits:
		order.append(h.damage)
	var maybe: Array[int?] = [2, None, 1]
	maybe.sort()
	var p: int? = None
	var q: int? = 5
	var keyed: Dictionary[Hit, int] = {Hit(damage = 2): 0, Hit(damage = 1): 1}
	keyed.sort()
	return str(order) + " " + hits[1].tags[0] + " " + str(hits.bsearch(Hit(damage = 2, tags = ["b"]))) + " " + str(hits.min().damage) + " " + str(hits.max().damage) + " " + str(Hit(damage = 1) < Hit(damage = 2)) + " " + str(maybe[0] == None and maybe[2] == 2 and p < q and q <= q) + " " + str(keyed.keys()[0].damage)

# The engine returns null for them, which int does not have (spec §3.8).
pub func least(values: Array[int]) -> int:
	return values.min()

pub func first(values: Array[int]) -> int:
	return values.front()

# Spec §5.1: in and not in, as has() and contains(); on an object, a member's name.
pub func contained() -> String:
	var weights: Array[float] = [1.0, 2.5]
	var hits: Array[Hit] = [Hit(damage = 2)]
	var names: Dictionary[String, int] = {"a": 1}
	var bytes := PackedByteArray()
	bytes.append(7)
	return str([1 in weights, 2 not in weights, Hit(damage = 2) in hits, &"a" in names, "b" in names, 7 in bytes, "ell" in "hello", &"x" in "hello", "name" in self, &"scores" in self, "nothing" in self, 3 in [1, 2, 3]])

# Spec §5.1: % formats a value of any type, this language's own as they enter
# the engine (§10.1); a format error is a program error.
pub func formatted(n: int, maybe: int?) -> String:
	var tail := "<%s>"
	tail %= maybe
	return "%d %s %s " % [n, maybe, Hit(damage = 3)] + tail + &" [%05.1f]" % 2.5

pub func misformatted() -> String:
	return "%d %d" % [1]

# A method that changes a packed array in a container writes it back.
pub func packed_elements() -> String:
	var rows: Array[PackedInt32Array] = [PackedInt32Array()]
	rows[0].push_back(1)
	var by_name: Dictionary[String, PackedInt32Array] = {"a": PackedInt32Array()}
	by_name["a"].append(2)
	return str(rows) + " " + str(by_name)

# The copy of a key that holds itself holds itself, and that of a key holding a
# container twice holds one copy twice.
pub func cyclic_keys() -> String:
	var a: Array = []
	a.append(a)
	var d: Dictionary[Array, int] = {}
	d[a] = 1
	var k := d.keys()[0]
	var inner: Array = []
	var e: Dictionary[Array, int] = {}
	e[[inner, inner]] = 1
	var p := e.keys()[0]
	return str(d.size()) + " " + str(k.is_read_only()) + " " + str(is_same(k[0], k)) + " " + str(is_same(p[0], p[1])) + " " + str(is_same(p[0], inner))

# Members of another instance, in their slots (spec §4.2, §10.5): one that is
# not pub, one through its setter, and containers that keep boxes, which
# reflection does not list.
pub var kept_hits: Array[Hit] = []
pub var kept_calls: Array[func() -> void] = []
var secret := 0
var doubled := 0:
	set(value):
		doubled = value * 2
@onready var children_at_ready: int = get_child_count()

pub func other_members(peer: ContainerCheck) -> String:
	peer.secret = 5
	peer.doubled = 4
	peer.kept_hits.append(Hit(damage = 6))
	return str(peer.secret) + " " + str(peer.doubled) + " " + str(peer.kept_hits[0].damage)

pub func early_member(peer: ContainerCheck) -> int:
	return peer.children_at_ready

# Method values of another instance, which do not keep it (spec §3.11): one
# without pub and one of the engine.
func secret_plus(n: int) -> int:
	return secret + n

pub func method_values(peer: ContainerCheck) -> String:
	peer.secret = 2
	var plus := peer.secret_plus
	var count := peer.get_child_count
	return str(plus.call(3)) + " " + str(count.call(false))

pub func freed_receiver() -> int:
	var peer := ContainerCheck.new()
	var plus := peer.secret_plus
	peer.free()
	return plus.call(1)

# Static functions as values (spec §3.11): the engine calls one without an
# object, and finds an equal one to disconnect.
static var ticks := 0

static func descending(a: int, b: int) -> bool:
	return a > b

static func tick() -> void:
	ticks += 1

static func is_even(n: int) -> bool:
	return n % 2 == 0

# Containers keep function values boxed as well, and Array(x) gives their
# Callables (spec §3.8, §3.11).
pub func function_elements() -> String:
	var checks: Array[func(int) -> bool] = [is_even, func(n): return n > 2]
	checks.append(func(n): return n < 10)
	var passed := 0
	for check in checks:
		if check.call(4):
			passed += 1
	var named: Dictionary[String, func(int) -> bool] = {"even": checks[0]}
	var held := checks.filter(func(c: func(int) -> bool) -> bool: return c.call(1))
	return str(passed) + " " + str(named["even"].call(3)) + " " + str(checks.has(is_even)) + " " + str(held.size()) + " " + str(Array(checks)[0] == is_even)

pub func static_values() -> String:
	var numbers: Array[int] = [1, 3, 2]
	numbers.sort_custom(descending)
	var exists := FileAccess.file_exists
	var timer := Timer.new()
	timer.timeout.connect(ContainerCheck.tick)
	timer.timeout.emit()
	timer.timeout.disconnect(tick)
	timer.timeout.emit()
	timer.free()
	return str(numbers) + " " + str(exists.call("res://project.godot")) + " " + str(ticks)

# A struct's methods as values (spec §3.11): an instance method keeps the copy
# it was taken from.
struct Tally:
	var count: int = 0

	func plus(n: int) -> int:
		return count + n

	static func of(n: int) -> Tally:
		return Tally(count = n)

pub func struct_method_values() -> String:
	var tally := Tally(count = 2)
	var plus := tally.plus
	tally = Tally.of(10)
	var make := Tally.of
	return str(plus.call(3)) + " " + str(make.call(4).count) + " " + str(tally.count)

signal _done(value: int)

pub func private_signals() -> String:
	var got: Array[int] = []
	_done.connect(func(value: int): got.append(value))
	_done.emit(3)
	return str(got) + " " + str(_done.get_name())

pub signal pinged
pub var tally := 0

pub func bump(n: int):
	tally += n

pub func literal_names() -> String:
	set("tally", 5)
	var c := Callable(self, "bump")
	c.call(2)
	return str(tally) + " " + str(c == bump) + " " + str(Signal(self, "pinged") == pinged)

# Elements of packed arrays read in their slots' types, bytes and 32-bit
# floats widened.
pub func packed_reads() -> String:
	var bytes := PackedByteArray()
	bytes.append(200)
	bytes.append(7)
	var halves := PackedFloat32Array()
	halves.append(1.5)
	halves.append(-2.0)
	var names := PackedStringArray()
	names.append("a")
	names.append("b")
	var total := 0.0
	for h in halves:
		total += h
	var text := ""
	for n in names:
		text += n
	return str(bytes[0] + bytes[-1]) + " " + str(total) + " " + text + names[1]


# A struct and an enum with payloads hold themselves through containers
# (spec §3.6), also across the engine boundary (§10.1).
pub struct Twig:
	var name: String
	var children: Array[Twig] = []

pub enum Expr { NUM(v: int), ADD(items: Array[Expr]) }

pub func recursive() -> String:
	var leaf := Twig(name = "leaf")
	var root := Twig(name = "root", children = [leaf, Twig(name = "b", children = [leaf])])
	var encoded: Variant = root
	var back := Twig.try_from(encoded).unwrap()
	var keyed: Dictionary[Twig, int] = {root: 1}
	var sum := Expr.ADD(items = [Expr.NUM(v = 1), Expr.NUM(v = 2)])
	var untyped := Array(root.children)
	var expected: Variant = {"name": "b", "children": [{"name": "leaf", "children": []}]}
	return root.children[1].children[0].name + " " + str(back == root) + " " + str(keyed[back]) + " " + str(sum == Expr.ADD(items = [Expr.NUM(v = 1), Expr.NUM(v = 2)])) + " " + str(Array[Twig].try_from(untyped).unwrap() == root.children) + " " + str(untyped[1] == expected)


# One that holds itself through a container it shares has no end; walks into
# it stop as the engine's do.
pub func endless() -> String:
	var a := Twig(name = "c")
	a.children.append(a)
	var b := Twig(name = "c")
	b.children.append(b)
	var same := a == b
	var text := str(a)
	var encoded := Array(a.children)
	a.children.clear()
	b.children.clear()
	return str(same) + " " + str(text.begins_with("{ \"name\": \"c\"")) + " " + str(encoded.size())
