class_name ConstantCheck extends RefCounted

# Constants (spec §4.5): the compiler computes scalars, the engine the rest
# once, when the class loads.

pub const DAY_MS = 24 * 60 * 60 * 1000
pub const MASK = 1 << 3 | 1
pub const EXTENTS := Vector3.ONE / 2.0
pub const HALF_X = EXTENTS.x
pub const TINT = Color.WHITE * Color(1, 1, 1, 0.5)
pub const ANGLE = deg_to_rad(30)
pub const SLOPE = tan(ANGLE)
pub const RIGHT = Vector2(1, 0) == Vector2.RIGHT
pub const NAMES = ["a", "b"]
pub const LIMITS = {"hp": 100, "mp": 50}
pub const RED = Color("#ff0000")
pub const LIMIT: int? = 3
pub const FALLBACK: Node? = None
const SECRET = 7


pub func day() -> int:
	return DAY_MS + MASK - 9


pub func extents() -> Vector3:
	return EXTENTS


pub func half_x() -> float:
	return HALF_X


pub func tint() -> Color:
	return TINT


pub func angle() -> float:
	return ANGLE


pub func slope() -> float:
	return SLOPE


pub func right() -> bool:
	return RIGHT


pub func red() -> Color:
	return RED


pub func names() -> Array[String]:
	return NAMES


pub func hp() -> int:
	return LIMITS["hp"]


pub func read_only() -> bool:
	return NAMES.is_read_only() and LIMITS.is_read_only()


pub func change() -> void:
	var names := NAMES
	names.append("c")


pub func secret() -> int:
	return SECRET


pub func limit() -> int:
	return LIMIT.unwrap() if FALLBACK == None else 0


# Spec §5.1: bitwise operators at run time.
pub func bits(x: int, n: int) -> int:
	var flags := x & 240 | n ^ 1
	flags <<= 2
	flags >>= 1
	flags |= 1
	flags &= ~4
	flags ^= 8
	return flags


pub func shift(x: int, n: int) -> int:
	return x << n

# The engine's global constants, which the compiler takes from godot-cpp's API description.
pub func global_constants() -> Array:
	return [KEY_ESCAPE, MOUSE_BUTTON_RIGHT, PROPERTY_HINT_FILE_PATH, INT64_MIN]

# Spec §5.1: ** of ints is exact and wraps as * does; of floats the engine's pow.
pub const POWERS = [2 ** 3 ** 2, -2 ** 2, 3 ** 39, 2 ** -1, (-1) ** -3]
pub const ROOT = 2.0 ** 0.5


pub func power(a: int, n: int) -> int:
	var x := a ** n
	x **= 1
	return x


pub func root(x: float) -> float:
	return x ** 0.5

# Spec §3.7: enums without payloads.
pub enum Mode { CALM, ANGRY = 3 }
pub enum { SMALL, LARGE }
@export pub var mode := Mode.ANGRY


pub func mode_of(n: int) -> Mode:
	return Mode(n)


pub func takes_mode(m: Mode) -> int:
	return m + LARGE
