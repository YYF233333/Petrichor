# GDScript classes as reflection shows them (spec §11.1): GdViewBase and its
# subclass GdViewChild. Driven by language_test.gd.
class_name GdViewCheck
extends Node

pub func doubled(base: GdViewBase) -> int:
	return base.hit(21)

pub func faster(base: GdViewBase) -> float:
	base.speed = base.speed * 2.0
	return base.speed

pub func score(base: GdViewBase):
	base.scored.emit(7)

pub func buddy_is_child(base: GdViewBase) -> bool:
	var buddy: GdViewBase? = base.buddy
	return buddy != None and buddy is GdViewChild

pub func as_child(node: Node) -> GdViewChild?:
	return node as GdViewChild

pub func as_base(node: Node) -> GdViewBase?:
	return node as GdViewBase

# Through the class: new(), static methods and constants (spec §11.1), by a
# class_name or a preload (§2.1).
const Unit = preload("preload_unit.gd")
const Grid = preload("preload_grid.pet")

pub func through_classes() -> Array:
	var base := GdViewBase.new()
	var unit: Unit = Unit.new(3)
	var direct := preload("preload_unit.gd").new()
	var made := Unit.make(2)
	var plain := Node2D.new()
	plain.set_script(Unit)
	var script: GDScript = Unit
	var grid := Grid.new()
	grid.clear()
	var result: Array = [base.hit(1), GdViewBase.scaled(2), base.scaled(3), GdViewBase.BONUS, unit.level, direct.level, made != None and made.name == &"made 2", Unit.TILE_SIZE, plain is Unit, script.resource_path, Grid.cell(40), preload("preload_grid.pet").cell(32), Grid.SIZE, grid.cleared]
	if made != None:
		made.free()
	for node: Node in [base, unit, direct, plain, grid]:
		node.free()
	return result

# A member typed by a preloaded GDScript class without a class_name, which
# other classes read (spec §2.1).
pub var unit: Unit?

# A GDScript class that defines _iter_init, _iter_next and _iter_get (spec §5.7).
pub func counted(base: GdViewBase) -> Array[int]:
	var all: Array[int] = []
	for n in base:
		all.append(n)
	return all
