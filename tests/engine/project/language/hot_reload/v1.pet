# Hot reload, version 1. run.py copies each later version over it (hot_reload_test.gd).
extends Node

pub var count := 0
# Not a literal: run by the init function, which records its line.
var origin := Vector3(1, 2, 3)

pub func value() -> int:
	return 1

pub signal tick
pub async func delayed() -> int:
	await tick
	return 100 + value()
