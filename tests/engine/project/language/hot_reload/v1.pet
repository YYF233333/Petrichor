# Hot reload, version 1. run.py copies each later version over it (hot_reload_test.gd).
extends Node

pub var count := 0
# Not a literal: run by the init function, which records its line.
var origin := Vector3(1, 2, 3)
pub static var hits := 0
static var inits := 0

static func _static_init() -> void:
	inits += 1

pub func hit() -> int:
	hits += 1
	return hits + 100 * inits

pub func value() -> int:
	return 1

pub signal tick
pub async func delayed() -> int:
	await tick
	return 100 + value()

pub class Part:
	pub func value() -> int:
		return 1
