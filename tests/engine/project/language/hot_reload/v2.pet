# Hot reload, version 2: only a function body changed, and a comment line was
# added above the members, which moves the line the init function records.
extends Node

pub var count := 0
# Not a literal: run by the init function, which records its line.
var origin := Vector3(1, 2, 3)
pub static var hits := 0
# Compared by its bits, as NAN equals nothing (spec §12.4).
pub const LIMIT := NAN
# A type in version 1 and a value in version 2, which is a body change (spec §2.1, §12.4).
const Grid = preload("res://language/preload_grid.pet")
static var inits := 0

static func _static_init() -> void:
	inits += 10

pub func hit() -> int:
	hits += 1
	return hits + 1000 * inits

pub func value() -> int:
	return count * 10 + Grid.SIZE - 16

func gridded(g: Variant) -> bool:
	return g is Grid

pub signal tick
pub async func delayed() -> int:
	await tick
	return 200 + value()

pub class Part:
	pub func value() -> int:
		return 2
