# Hot reload, version 4: only a function body changed since version 3, which
# was refused, so this is not applied either (spec §12.4).
extends Node

pub var count := 0
pub var extra := 0
var origin := Vector3(1, 2, 3)
pub static var hits := 0
static var inits := 0

static func _static_init() -> void:
	inits += 10

pub func hit() -> int:
	hits += 1
	return hits + 1000 * inits

pub func value() -> int:
	return count * 100 + extra

pub signal tick
pub async func delayed() -> int:
	await tick
	return 400 + value()

pub class Part:
	pub func value() -> int:
		return 4
