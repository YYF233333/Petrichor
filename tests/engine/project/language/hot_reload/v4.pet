# Hot reload, version 4: only a function body changed since version 3, which
# was refused, so this is not applied either (spec §12.4).
extends Node

pub var count := 0
pub var extra := 0
var origin := Vector3(1, 2, 3)

pub func value() -> int:
	return count * 100 + extra

pub signal tick
pub async func delayed() -> int:
	await tick
	return 400 + value()
