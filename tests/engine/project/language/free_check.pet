# self freed, or detached from its script, while one of its methods runs: using
# a member afterwards is a program error (spec §3.3), where it read memory
# already freed. Driven by language_test.gd.
class_name FreeCheck
extends Node

signal fired
pub var count := 7

# Called by another object of this language, without the lock that keeps an
# object from being freed within a call through Object::callp
# (core/object/object.cpp:784-788, 798), and with no engine code that touches
# it after the call; freeing self in _process() leaves the engine reading it
# (:908-914).
pub func free_and_read() -> int:
	free()
	return count

pub func detach_and_read() -> int:
	var no_script: Script? = None
	set_script(no_script)
	return count

# Without using a member or self after it, the method ends normally.
pub func detach_and_return(value: int) -> int:
	var no_script: Script? = None
	set_script(no_script)
	return value * 2

# Emitting locks the emitter against free() (core/object/object.cpp:1237), but
# not against losing its script.
pub func fire_and_read() -> int:
	fired.emit()
	return count

pub func free_other(other: FreeCheck) -> int:
	return other.free_and_read()
