# Annotations that describe the class to the engine (spec §2.3), compared by
# language_test.gd with annotation_reference.gd, which writes them in GDScript.
@static_unload
@icon("icons/annotation.svg") class_name AnnotationCheck
extends Node

@warning_ignore_start("unused_private_class_variable")
@export_file("*.json", "*.txt") pub var data_file: String
@export pub var anything: Variant
@export_file_path pub var any_file: String
@export_dir pub var folder: String
@export_global_file("*.png") pub var image_file: String
@export_global_dir pub var global_folder: String
@export_placeholder("Name") pub var title: String
@export_multiline("Hint") pub var notes: String
@export_exp_easing("attenuation") pub var easing: float
@export_color_no_alpha pub var tint: Color
@export_node_path("Node3D", "Label") pub var target: NodePath
@export_flags("Fire", "Water:4", "Earth") pub var elements: int
@export_flags_2d_render pub var render_layers: int
@export_flags_3d_physics pub var physics_layers: int
@export_flags_avoidance pub var avoidance_layers: int
@export_file("*.png") pub var images: Array[String]
@export_range(0, 1, 0.1) pub var weights: PackedFloat32Array
@export_enum("Low", "High") pub var levels: Array[int]
@export_storage pub var saved := 3
@export_custom(PROPERTY_HINT_LINK, "suffix:m/s") pub var speed := Vector2.ONE
@export_custom(PROPERTY_HINT_NONE, "suffix:s", PROPERTY_USAGE_EDITOR) pub var delay := 0.5
@warning_ignore_restore("unused_private_class_variable")

var hits := 0

@rpc("any_peer", "call_local", "unreliable_ordered", 2)
pub func hit(amount: int):
	@warning_ignore("narrowing_conversion")
	hits += amount

@rpc
pub func sync_state():
	pass

@rpc("call_remote", "reliable")
pub func confirm():
	pass

pub func hit_count() -> int:
	return hits
