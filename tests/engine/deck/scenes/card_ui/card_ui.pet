class_name CardUI
extends Control

pub signal reparent_requested(which_card_ui: CardUI)

pub const BASE_STYLEBOX: StyleBoxFlat = preload("res://scenes/card_ui/card_base_stylebox.tres")
pub const DRAG_STYLEBOX: StyleBoxFlat = preload("res://scenes/card_ui/card_drag_stylebox.tres")
pub const HOVER_STYLEBOX: StyleBoxFlat = preload("res://scenes/card_ui/card_hover_stylebox.tres")

@late @export var player_modifiers: ModifierHandler
@export var card: Card? : set = _set_card
@late @export var char_stats: CharacterStats : set = _set_char_stats

@onready pub var card_visuals: CardVisuals = $CardVisuals
@onready pub var drop_point_detector: Area2D = $DropPointDetector
@onready pub var card_state_machine: CardStateMachine = $CardStateMachine
@onready pub var targets: Array[Node] = []

pub var original_index := 0
@late pub var parent: Control
pub var tween: Tween?
pub var playable := true : set = _set_playable
pub var disabled := true


func _ready() -> void:
	Events.card_aim_started.connect(_on_card_drag_or_aiming_started)
	Events.card_drag_started.connect(_on_card_drag_or_aiming_started)
	Events.card_drag_ended.connect(_on_card_drag_or_aim_ended)
	Events.card_aim_ended.connect(_on_card_drag_or_aim_ended)
	card_state_machine.init(self)


func _input(event: InputEvent) -> void:
	card_state_machine.on_input(event)


pub func animate_to_position(new_position: Vector2, duration: float) -> void:
	tween = create_tween().set_trans(Tween.TRANS_CIRC).set_ease(Tween.EASE_OUT)
	tween.unwrap().tween_property(self, "global_position", new_position, duration)


pub func play() -> void:
	if not is_instance_valid(card):
		return

	card.unwrap().play(targets, char_stats, player_modifiers)
	queue_free()


func get_active_enemy_modifiers() -> ModifierHandler?:
	if targets.is_empty() or targets.size() > 1 or not targets[0] is Enemy:
		return null

	return (targets[0] as Enemy).unwrap().modifier_handler


pub func is_hovered() -> bool:
	var rect := Rect2(Vector2.ZERO, self.size)
	return rect.has_point(get_local_mouse_position())


pub func request_tooltip() -> void:
	var enemy_modifiers := get_active_enemy_modifiers()
	var updated_tooltip := card.unwrap().get_updated_tooltip(player_modifiers, enemy_modifiers)
	Events.card_tooltip_requested.emit(card.unwrap().icon, updated_tooltip)


pub func _on_gui_input(event: InputEvent) -> void:
	card_state_machine.on_gui_input(event)


pub func _on_mouse_entered() -> void:
	card_state_machine.on_mouse_entered()


pub func _on_mouse_exited() -> void:
	card_state_machine.on_mouse_exited()


async func _set_card(value: Card?) -> void:
	if not is_node_ready():
		await ready

	card = value
	card_visuals.card = card.unwrap()


func _set_playable(value: bool) -> void:
	playable = value
	if not playable:
		card_visuals.cost.add_theme_color_override("font_color", Color.RED)
		card_visuals.icon.modulate = Color(1, 1, 1, 0.5)
	else:
		card_visuals.cost.remove_theme_color_override("font_color")
		card_visuals.icon.modulate = Color(1, 1, 1, 1)


func _set_char_stats(value: CharacterStats) -> void:
	char_stats = value
	char_stats.stats_changed.connect(_on_char_stats_changed)
	_on_char_stats_changed()


pub func _on_drop_point_detector_area_entered(area: Area2D) -> void:
	if not targets.has(area):
		targets.append(area)


pub func _on_drop_point_detector_area_exited(area: Area2D) -> void:
	targets.erase(area)


func _on_card_drag_or_aiming_started(used_card: CardUI) -> void:
	if used_card == self:
		return

	disabled = true


func _on_card_drag_or_aim_ended(_card: CardUI) -> void:
	disabled = false
	playable = char_stats.can_play_card(card.unwrap())


func _on_char_stats_changed() -> void:
	playable = char_stats.can_play_card(card.unwrap())
