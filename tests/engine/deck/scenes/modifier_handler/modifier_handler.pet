class_name ModifierHandler
extends Node


func has_modifier(type: Modifier.Type) -> bool:
	for modifier: Modifier in get_children():
		if modifier.type == type:
			return true

	return false


pub func get_modifier(type: Modifier.Type) -> Modifier?:
	for modifier: Modifier in get_children():
		if modifier.type == type:
			return modifier

	return null


pub func get_modified_value(base: int, type: Modifier.Type) -> int:
	var modifier := get_modifier(type)

	if not is_instance_valid(modifier):
		return base

	return modifier.unwrap().get_modified_value(base)
