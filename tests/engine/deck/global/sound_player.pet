extends Node


pub func play(audio: AudioStream?, single: bool=false) -> void:
	if audio == None:
		return

	if single:
		stop()

	for player: AudioStreamPlayer in get_children():
		if not player.playing:
			player.stream = audio
			player.play()
			break


func stop() -> void:
	for player: AudioStreamPlayer in get_children():
		player.stop()
