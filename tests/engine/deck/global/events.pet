extends Node

# Card-related events
pub signal card_drag_started(card_ui: CardUI)
pub signal card_drag_ended(card_ui: CardUI)
pub signal card_aim_started(card_ui: CardUI)
pub signal card_aim_ended(card_ui: CardUI)
pub signal card_played(card: Card)
pub signal card_tooltip_requested(icon: Texture2D, text: String)
pub signal tooltip_hide_requested

# Player-related events
pub signal player_hand_drawn
pub signal player_hand_discarded
pub signal player_turn_ended
pub signal player_hit
pub signal player_died

# Enemy-related events
pub signal enemy_action_completed(enemy: Enemy)
pub signal enemy_turn_ended
pub signal enemy_died(enemy: Enemy)

# Battle-related events
pub signal battle_over_screen_requested(text: String, type: BattleOverPanel.Type)
pub signal battle_won
pub signal status_tooltip_requested(statuses: Array[Status])

# Map-related events
pub signal map_exited(room: Room)

# Shop-related events
pub signal shop_entered(shop: Shop)
pub signal shop_relic_bought(relic: Relic, gold_cost: int)
pub signal shop_card_bought(card: Card, gold_cost: int)
pub signal shop_exited

# Campfire-related events
pub signal campfire_exited

# Battle Reward-related events
pub signal battle_reward_exited

# Treasure Room-related events
pub signal treasure_room_exited(found_relic: Relic?)

# Relic-related events
pub signal relic_tooltip_requested(relic: Relic)

# Random Event room-related events
pub signal event_room_exited
