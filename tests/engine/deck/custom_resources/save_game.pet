class_name SaveGame
extends Resource

const SAVE_PATH := "user://savegame.tres"

@export var rng_seed: int
@export var rng_state: int
@late @export var run_stats: RunStats
@late @export var char_stats: CharacterStats
@late @export var current_deck: CardPile
@export var current_health: int
@export var relics: Array[Relic]
@export var map_data: Array[Array[Room]]
@export var last_room: Room?
@export var floors_climbed: int
@export var was_on_map: bool


pub func save_data() -> void:
	var err := ResourceSaver.save(self, SAVE_PATH)
	assert(err == OK, "Couldn't save the game!")


pub static func load_data() -> SaveGame?:
	if FileAccess.file_exists(SAVE_PATH):
		return ResourceLoader.load(SAVE_PATH) as SaveGame

	return null


pub static func delete_data() -> void:
	if FileAccess.file_exists(SAVE_PATH):
		DirAccess.remove_absolute(SAVE_PATH)
