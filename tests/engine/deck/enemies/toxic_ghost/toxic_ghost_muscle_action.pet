extends EnemyAction


pub func perform_action() -> void:
	if enemy == None or target == None:
		return

	var tween := create_tween().set_trans(Tween.TRANS_QUINT)
	var start := enemy.unwrap().global_position
	var end := target.unwrap().global_position + Vector2.RIGHT * 32

	SFXPlayer.play(sound)

	Events.enemy_action_completed.emit(enemy.unwrap())
