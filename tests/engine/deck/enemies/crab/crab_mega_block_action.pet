extends EnemyAction

@export var block := 15
@export var hp_threshold := 6

var already_used := false


pub func is_performable() -> bool:
	if enemy == None or already_used:
		return false

	return enemy.unwrap().stats.health <= hp_threshold


pub func perform_action() -> void:
	if enemy == None or target == None:
		return

	var block_effect := BlockEffect.new()
	block_effect.amount = block
	block_effect.sound = sound
	block_effect.execute([enemy.unwrap()])
	already_used = true

	get_tree().create_timer(0.6, false).timeout.connect(
		func():
			Events.enemy_action_completed.emit(enemy.unwrap())
	)
