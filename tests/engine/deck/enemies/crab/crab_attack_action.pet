extends EnemyAction

@export var damage := 7


pub func perform_action() -> void:
	if enemy == None or target == None:
		return

	var tween := create_tween().set_trans(Tween.TRANS_QUINT)
	var start := enemy.unwrap().global_position
	var end := target.unwrap().global_position + Vector2.RIGHT * 32
	var damage_effect := DamageEffect.new()
	var target_array: Array[Node] = [target.unwrap()]
	damage_effect.amount = damage
	damage_effect.sound = sound

	tween.tween_property(enemy.unwrap(), "global_position", end, 0.4)
	tween.tween_callback(damage_effect.execute.bind(target_array))
	tween.tween_interval(0.25)
	tween.tween_property(enemy.unwrap(), "global_position", start, 0.4)

	tween.finished.connect(
		func():
			Events.enemy_action_completed.emit(enemy.unwrap())
	)


pub func update_intent_text() -> void:
	var player := target as Player
	if player == None:
		return

	var modified_dmg := player.modifier_handler.get_modified_value(damage, Modifier.Type.DMG_TAKEN)
	intent.current_text = intent.base_text % modified_dmg
